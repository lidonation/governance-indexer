# Database Configuration
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cexplorer
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_ACQUIRE_TIMEOUT_SECS=30
DB_RETRY_ATTEMPTS=0
DB_RETRY_DELAY_SECS=5

# Network Configuration
# Comma-separated list of relay addresses
RELAY_ADDRESSES=relay1.lidonation.com:3011
# Primary relay address
RELAY_ADDRESS=relay1.lidonation.com:3011
CONNECTION_TIMEOUT_SECS=10
NETWORK_MAGIC=764824073
RETRY_ATTEMPTS=3

# Processing Configuration
MAX_CONCURRENT_WORKERS=10
BATCH_SIZE=1000
CONTINUOUS_SYNC_INTERVAL_SECS=20
SLOT_HASHES_FILE=slot_hashes.csv
